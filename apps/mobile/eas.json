{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:4000",
        "CLERK_MOCK_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.relay.app",
        "EXPO_PUBLIC_WS_URL": "wss://api.staging.relay.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.relay.app",
        "EXPO_PUBLIC_WS_URL": "wss://api.relay.app"
      },
      "submit": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "# Set APPLE_ID in EAS secrets",
        "ascAppId": "# Set ASC_APP_ID in EAS secrets",
        "appleTeamId": "# Set APPLE_TEAM_ID in EAS secrets"
      },
      "android": {
        "serviceAccountKeyPath": "# Set GOOGLE_SERVICE_ACCOUNT_KEY_PATH or use EAS secrets",
        "track": "internal"
      }
    }
  }
}
